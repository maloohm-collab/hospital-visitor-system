rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /staff_message_media/{threadId}/{senderUid}/{fileName} {
      function signedIn() {
        return request.auth != null;
      }
      function isActiveUser() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
      }
      function recipientMessage() {
        return firestore.exists(/databases/(default)/documents/staff_messages/$(threadId + '_' + request.auth.uid));
      }
      function replyMessage() {
        return firestore.exists(/databases/(default)/documents/staff_messages/$(threadId + '_' + senderUid))
          && firestore.get(/databases/(default)/documents/staff_messages/$(threadId + '_' + senderUid)).data.senderUid == request.auth.uid
          && firestore.get(/databases/(default)/documents/staff_messages/$(threadId + '_' + senderUid)).data.recipientUid == senderUid;
      }
      allow write: if isActiveUser()
        && request.resource != null
        && request.auth.uid == senderUid
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|gif)');
      allow delete: if isActiveUser() && request.auth.uid == senderUid;
      allow read: if isActiveUser() && (
        request.auth.uid == senderUid
        || (recipientMessage()
          && firestore.get(/databases/(default)/documents/staff_messages/$(threadId + '_' + request.auth.uid)).data.senderUid == senderUid)
        || replyMessage()
      );
    }
  }
}