rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveSupervisor() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    match /account_requests/{uid} {
      // Applicants may create only their own pending request.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'requestedRole', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'requestedRole', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole in ['security_officer', 'supervisor']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;

      // Applicants can inspect their own request; active admins can review the queue.
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin();

      // Admin decisions are constrained and committed atomically with profile creation.
      allow update: if signedIn() && (
        (
          isActiveAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'email', 'requestedRole', 'status',
            'createdAt', 'reviewedAt', 'reviewedBy'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.email == resource.data.email
          && request.resource.data.requestedRole == resource.data.requestedRole
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (
            request.resource.data.status == 'rejected'
            || (
              getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
              && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == resource.data.requestedRole
              && getAfter(/databases/$(database)/documents/users/$(uid)).data.approvedBy == request.auth.uid
            )
          )
        )
        ||
        (
          request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'createdAt', 'reviewedAt', 'reviewedBy'
          ])
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.requestedRole == resource.data.requestedRole
          && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy'])
        )
      );

      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());

      // A verified admin may create an applicant profile only as part of the same
      // atomic batch that marks that applicant's pending request approved.
      allow create: if isActiveAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'status',
          'createdAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'status',
          'createdAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role in ['security_officer', 'supervisor']
        && request.resource.data.status == 'active'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.requestedRole == request.resource.data.role
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.reviewedBy == request.auth.uid;

      allow list, update, delete: if false;
    }

    match /visitor_logs/{visitId} {
      // Only active staff may create records, and each record is tied to its creator.
      allow create: if isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'supervisor', 'security_officer']
        && request.resource.data.keys().hasOnly([
          'visitId', 'floorId', 'floorName', 'department', 'roomNumber',
          'visitorCount', 'visitDate', 'entryAt', 'exitAt', 'notes',
          'status', 'createdBy', 'createdByEmail', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'visitId', 'floorId', 'floorName', 'department', 'roomNumber',
          'visitorCount', 'visitDate', 'entryAt', 'exitAt', 'notes',
          'status', 'createdBy', 'createdAt'
        ])
        && request.resource.data.visitId == visitId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.floorId in [
          'floor_5', 'floor_4', 'floor_3', 'floor_2', 'floor_1', 'ccu'
        ]
        && request.resource.data.floorName is string
        && request.resource.data.department is string
        && request.resource.data.roomNumber is string
        && request.resource.data.visitorCount is int
        && request.resource.data.visitorCount >= 1
        && request.resource.data.visitDate is timestamp
        && request.resource.data.entryAt is timestamp
        && request.resource.data.exitAt is timestamp
        && request.resource.data.exitAt >= request.resource.data.entryAt
        && request.resource.data.notes is string
        && request.resource.data.status == 'completed'
        && request.resource.data.createdAt == request.time;

      // Staff can view their own records; supervisors and admins can review all records.
      allow get, list: if isActiveUser()
        && (
          resource.data.createdBy == request.auth.uid
          || isActiveSupervisor()
          || isActiveAdmin()
        );

      // Visit records are immutable for audit integrity.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}