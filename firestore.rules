rules_version = '2';
// Staff-message notification validation aligned with the message composer (minimum 3 chars).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveAdmin() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveSupervisor() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function isEmergencyRecipient(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['supervisor', 'admin'];
    }
    function validEmergencyRecipients(data) {
      return data.recipientUids is list
        && data.recipientUids.size() >= 1 && data.recipientUids.size() <= 5
        && isEmergencyRecipient(data.recipientUids[0])
        && (data.recipientUids.size() < 2 || isEmergencyRecipient(data.recipientUids[1]))
        && (data.recipientUids.size() < 3 || isEmergencyRecipient(data.recipientUids[2]))
        && (data.recipientUids.size() < 4 || isEmergencyRecipient(data.recipientUids[3]))
        && (data.recipientUids.size() < 5 || isEmergencyRecipient(data.recipientUids[4]));
    }


    function isWorkNoteRecipient(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['supervisor', 'admin'];
    }

    function validWorkNoteRecipients(data) {
      return data.recipientUids is list
        && data.recipientUids.size() >= 1 && data.recipientUids.size() <= 5
        && isWorkNoteRecipient(data.recipientUids[0])
        && (data.recipientUids.size() < 2 || isWorkNoteRecipient(data.recipientUids[1]))
        && (data.recipientUids.size() < 3 || isWorkNoteRecipient(data.recipientUids[2]))
        && (data.recipientUids.size() < 4 || isWorkNoteRecipient(data.recipientUids[3]))
        && (data.recipientUids.size() < 5 || isWorkNoteRecipient(data.recipientUids[4]));
    }

    match /account_requests/{uid} {
      // Applicants may create only their own pending request.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'email', 'requestedRole', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'phone', 'email', 'requestedRole', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole in ['security_officer', 'supervisor']
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 3
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;

      // Applicants can inspect their own request; active admins can review the queue.
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin();

      // Admin decisions are constrained and committed atomically with profile creation.
      allow update: if signedIn() && (
        (
          isActiveAdmin()
          && resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'phone', 'email', 'requestedRole', 'status',
            'createdAt', 'reviewedAt', 'reviewedBy'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.email == resource.data.email
          && request.resource.data.requestedRole == resource.data.requestedRole
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && (
            request.resource.data.status == 'rejected'
            || (
              getAfter(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
              && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == resource.data.requestedRole
              && getAfter(/databases/$(database)/documents/users/$(uid)).data.approvedBy == request.auth.uid
            )
          )
        )
        ||
        (
          request.auth.uid == uid
          && resource.data.status == 'rejected'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'createdAt', 'reviewedAt', 'reviewedBy'
          ])
          && request.resource.data.status == 'pending'
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.phone == resource.data.phone
          && request.resource.data.requestedRole == resource.data.requestedRole
          && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy'])
        )
      );

      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());

      // A verified admin may create an applicant profile only as part of the same
      // atomic batch that marks that applicant's pending request approved.
      allow create: if isActiveAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'phone', 'photoURL', 'email', 'role', 'status',
          'createdAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'phone', 'email', 'role', 'status',
          'createdAt', 'approvedAt', 'approvedBy'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.role in ['security_officer', 'supervisor']
        && request.resource.data.status == 'active'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.approvedAt == request.time
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.requestedRole == request.resource.data.role
        && getAfter(/databases/$(database)/documents/account_requests/$(uid)).data.reviewedBy == request.auth.uid;

      // Active staff may list only active profiles for the direct-contact directory.
      // Admins retain the full list permission needed by staff management.
      allow list: if isActiveAdmin()
        || (isActiveUser() && resource.data.status == 'active');

      // الموظف يعدّل بياناته الشخصية فقط، ولا يستطيع تغيير دوره أو حالته.
      // الإدارة تستطيع تعليق الحساب أو حظره أو إعادة تفعيله دون تغيير الدور.
      allow update: if isActiveUser() && (
        (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'photoURL'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 3
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 9
          && request.resource.data.photoURL is string
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.uid == resource.data.uid
        )
        || (
          isActiveAdmin()
          && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'suspended', 'blocked']
          && request.resource.data.role == resource.data.role
        )
      );

      allow delete: if isActiveAdmin() && uid != request.auth.uid;

      // Personal duty-roster archive preferences. A user can only manage
      // their own hidden-roster markers and retention settings.
      match /duty_roster_preferences/{preferenceId} {
        function isOwner() {
          return isActiveUser()
            && request.auth.uid == uid
            && get(/databases/$(database)/documents/users/$(uid)).data.role in ['security_officer', 'supervisor'];
        }

        allow get, list: if isOwner();

        allow create, update: if isOwner()
          && request.resource.data.ownerUid == uid
          && request.resource.data.updatedAt == request.time
          && (
            (
              preferenceId == 'settings'
              && request.resource.data.keys().hasOnly([
                'ownerUid', 'autoDeleteEnabled', 'retentionDays', 'updatedAt'
              ])
              && request.resource.data.keys().hasAll([
                'ownerUid', 'autoDeleteEnabled', 'retentionDays', 'updatedAt'
              ])
              && request.resource.data.autoDeleteEnabled is bool
              && request.resource.data.retentionDays is int
              && request.resource.data.retentionDays >= 1
              && request.resource.data.retentionDays <= 3650
            )
            || (
              preferenceId != 'settings'
              && request.resource.data.keys().hasOnly([
                'ownerUid', 'rosterKey', 'shift', 'action', 'reason', 'updatedAt'
              ])
              && request.resource.data.keys().hasAll([
                'ownerUid', 'rosterKey', 'shift', 'action', 'reason', 'updatedAt'
              ])
              && request.resource.data.rosterKey is string
              && request.resource.data.shift in ['A', 'B', 'C']
              && request.resource.data.action == 'hidden'
              && request.resource.data.reason in ['manual', 'manual_all', 'automatic']
            )
          );

        allow delete: if isOwner() && resource.data.ownerUid == uid;
      }
    }


      // Personal retention settings for the staff-message archive.
      match /message_archive_preferences/{preferenceId} {
        function isOwner() {
          return isActiveUser() && resource.data.ownerUid == request.auth.uid;
        }
        allow get: if isActiveUser() && preferenceId == request.auth.uid;
        allow list: if isOwner();
        allow create: if isActiveUser()
          && preferenceId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerUid', 'autoDeleteEnabled', 'retentionDays', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'ownerUid', 'autoDeleteEnabled', 'retentionDays', 'updatedAt'
          ])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.autoDeleteEnabled is bool
          && request.resource.data.retentionDays is int
          && request.resource.data.retentionDays >= 1
          && request.resource.data.retentionDays <= 3650
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'autoDeleteEnabled', 'retentionDays', 'updatedAt'
          ])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.autoDeleteEnabled is bool
          && request.resource.data.retentionDays is int
          && request.resource.data.retentionDays >= 1
          && request.resource.data.retentionDays <= 3650
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

    match /visitor_logs/{visitId} {
      // Save a record immediately when the visitor enters.
      allow create: if isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'supervisor', 'security_officer']
        && request.resource.data.keys().hasOnly([
          'visitId', 'floorId', 'floorName', 'department', 'roomNumber',
          'visitorCount', 'visitDate', 'entryAt', 'exitAt', 'notes',
          'status', 'createdBy', 'createdByEmail', 'createdByName', 'createdByPhone', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'visitId', 'floorId', 'floorName', 'department', 'roomNumber',
          'visitorCount', 'visitDate', 'entryAt', 'exitAt', 'notes',
          'status', 'createdBy', 'createdByName', 'createdByPhone', 'createdAt'
        ])
        && request.resource.data.visitId == visitId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByPhone is string
        && request.resource.data.floorId in [
          'floor_5', 'floor_4', 'floor_3', 'floor_2', 'floor_1', 'ccu'
        ]
        && request.resource.data.floorName is string
        && request.resource.data.department is string
        && request.resource.data.roomNumber is string
        && request.resource.data.visitorCount is int
        && request.resource.data.visitorCount >= 1
        && request.resource.data.visitDate is timestamp
        && request.resource.data.entryAt is timestamp
        && request.resource.data.exitAt == null
        && request.resource.data.notes is string
        && request.resource.data.status == 'inside'
        && request.resource.data.createdAt == request.time;

      // The creator may only add the exit time once; other fields are immutable.
      allow update: if isActiveUser()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'inside'
        && request.resource.data.status == 'completed'
        && request.resource.data.exitAt is timestamp
        && request.resource.data.exitAt >= resource.data.entryAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.notes is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['exitAt', 'status', 'updatedAt', 'notes'])
        && request.resource.data.keys().hasAll([
          'visitId', 'floorId', 'floorName', 'department', 'roomNumber',
          'visitorCount', 'visitDate', 'entryAt', 'exitAt', 'notes',
          'status', 'createdBy', 'createdAt', 'updatedAt'
        ]);

      // Officers may hide their own completed visit records from their personal list.
      // The shared visit record remains available to supervisors and administrators.
      allow update: if isActiveUser()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        && request.resource.data.hiddenFor is list
        && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))
        && request.resource.data.hiddenFor.size()
          == resource.data.get('hiddenFor', []).size() + 1
        && !resource.data.get('hiddenFor', []).hasAny([request.auth.uid])
        && request.resource.data.hiddenFor.hasAny([request.auth.uid]);

      // The visit creator may add, edit, or clear only the notes field on their own visit,
      // whether the visit is still inside or already completed. Other visit data stays immutable.
      allow update: if isActiveUser()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status in ['inside', 'completed']
        && request.resource.data.status == resource.data.status
        && request.resource.data.exitAt == resource.data.exitAt
        && request.resource.data.notes is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes']);

      // Staff can view their own records; supervisors and admins can review all records.
      allow get, list: if isActiveUser()
        && (
          resource.data.createdBy == request.auth.uid
          || isActiveSupervisor()
          || isActiveAdmin()
        );

      // Only completed visits can be deleted. Officers may delete their own;
      // supervisors and administrators may delete any completed visit.
      allow delete: if isActiveUser()
        && resource.data.status == 'completed'
        && (
          isActiveAdmin()
          || isActiveSupervisor()
          || (
            resource.data.createdBy == request.auth.uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
          )
        );
    }

    match /duty_reports/{reportId} {
      // Security officers may submit only their own incident/shift reports to the supervisor.
      // Supervisors may create internal reports or reports explicitly forwarded to administration.
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'reportId', 'type', 'title', 'body', 'employeeName', 'priority',
          'destination', 'status', 'createdBy', 'createdByEmail', 'createdByName', 'createdByPhone',
          'createdByRole', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'reportId', 'type', 'title', 'body', 'employeeName', 'priority',
          'destination', 'status', 'createdBy', 'createdByEmail', 'createdByName', 'createdByPhone',
          'createdByRole', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.employeeName is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByPhone is string
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
            && request.resource.data.createdByRole == 'security_officer'
            && request.resource.data.type in ['security_incident', 'shift_summary']
            && request.resource.data.destination == 'supervisor'
            && request.resource.data.status == 'submitted'
          )
          ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor'
            && request.resource.data.createdByRole == 'supervisor'
            && request.resource.data.type in [
              'security_incident', 'shift_summary', 'technical_note',
              'recommendation_positive', 'recommendation_concern'
            ]
            && request.resource.data.destination in ['internal', 'admin']
            && request.resource.data.status == (request.resource.data.destination == 'admin' ? 'forwarded' : 'saved')
          )
        );

      // Officers can read their own submissions; supervisors review all reports.
      // Admin queries must be limited to reports explicitly forwarded to administration.
      allow get, list: if isActiveUser() && (
        resource.data.createdBy == request.auth.uid
        || isActiveSupervisor()
        || (
          isActiveAdmin()
          && resource.data.destination == 'admin'
          && resource.data.status in ['forwarded', 'acknowledged']
        )
      );

      // Only an active supervisor may review a submitted officer report.
      allow update: if (
        isActiveSupervisor()
        && resource.data.createdByRole == 'security_officer'
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'destination', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['saved', 'forwarded']
        && request.resource.data.destination == (
          request.resource.data.status == 'forwarded' ? 'admin' : resource.data.destination
        )
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() > 0
        && request.resource.data.reviewedByName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
      ) || (
        isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
        && resource.data.createdBy == request.auth.uid
        && resource.data.createdByRole == 'security_officer'
        && resource.data.type == 'shift_summary'
        && resource.data.destination == 'supervisor'
        && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'priority', 'updatedAt'
        ])
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.type == 'shift_summary'
        && request.resource.data.destination == 'supervisor'
        && request.resource.data.status == 'submitted'
        && request.resource.data.updatedAt == request.time
      );

      // A report owner may edit only the text fields; routing and review state stay protected.
      allow update: if isActiveUser()
        && resource.data.createdBy == request.auth.uid
        && !(resource.data.destination == 'admin' && resource.data.status in ['forwarded', 'acknowledged'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'employeeName', 'priority', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.updatedAt == request.time;

      // Administration can confirm receipt of a report forwarded by a supervisor.
      allow update: if isActiveAdmin()
        && resource.data.destination == 'admin'
        && resource.data.status == 'forwarded'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminConfirmedBy', 'adminConfirmedAt', 'updatedAt'
        ])
        && request.resource.data.status == 'acknowledged'
        && request.resource.data.adminConfirmedBy == request.auth.uid
        && request.resource.data.adminConfirmedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Each recipient may hide a report from their own list without deleting the shared record.
      // The only allowed change is adding the current user's UID to hiddenFor.
      allow update: if isActiveUser()
        && (
          isActiveSupervisor()
          || (
            isActiveAdmin()
            && resource.data.destination == 'admin'
            && resource.data.status in ['forwarded', 'acknowledged']
          )
          || resource.data.createdBy == request.auth.uid
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        && request.resource.data.hiddenFor is list
        && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor', []))
        && request.resource.data.hiddenFor.size()
          == resource.data.get('hiddenFor', []).size() + 1
        && !resource.data.get('hiddenFor', []).hasAny([request.auth.uid])
        && request.resource.data.hiddenFor.hasAny([request.auth.uid]);

      // Report deletion follows role and destination:
      // - A supervisor may delete submitted reports routed to the supervisor,
      //   their own internal drafts, and their own reports forwarded to administration.
      // - An administrator may delete reports explicitly routed to administration
      //   after forwarding or acknowledgement.
      // - Other users may delete only their own internal saved drafts.
      allow delete: if isActiveUser() && (
        (
          isActiveSupervisor()
          && (
            (resource.data.destination == 'supervisor'
              && resource.data.status == 'submitted')
            || (resource.data.createdBy == request.auth.uid
              && resource.data.destination == 'internal'
              && resource.data.status == 'saved')
            || (resource.data.createdBy == request.auth.uid
              && resource.data.createdByRole == 'supervisor'
              && resource.data.destination == 'admin'
              && resource.data.status in ['forwarded', 'acknowledged'])
          )
        )
        || (
          isActiveAdmin()
          && resource.data.destination == 'admin'
          && resource.data.status in ['forwarded', 'acknowledged']
        )
        || (
          resource.data.createdBy == request.auth.uid
          && resource.data.destination == 'internal'
          && resource.data.status == 'saved'
        )
      );

    }

    function validEmergencyHolder(uid) {
      return uid is string
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['security_officer', 'supervisor'];
    }

    function isCurrentEmergencyHolder(shiftId) {
      return isActiveUser()
        && exists(/databases/$(database)/documents/emergency_duty_shifts/$(shiftId))
        && get(/databases/$(database)/documents/emergency_duty_shifts/$(shiftId)).data.holderUid == request.auth.uid
        && get(/databases/$(database)/documents/emergency_duty_shifts/$(shiftId)).data.endsAt > request.time;
    }

    match /emergency_duty_shifts/{shiftId} {
      // Active staff can view the assignment; only active supervisors can assign.
      allow get, list: if isActiveUser();

      allow create: if isActiveSupervisor()
        && request.resource.data.keys().hasOnly([
          'shiftId', 'shiftLabel', 'startsAt', 'endsAt', 'holderUid', 'holderName',
          'handoverHistory', 'startedAt', 'updatedAt',
          'assignedByUid', 'assignedByName', 'assignedAt'
        ])
        && request.resource.data.keys().hasAll([
          'shiftId', 'shiftLabel', 'startsAt', 'endsAt', 'holderUid', 'holderName',
          'handoverHistory', 'startedAt', 'updatedAt',
          'assignedByUid', 'assignedByName', 'assignedAt'
        ])
        && request.resource.data.shiftId == shiftId
        && validEmergencyHolder(request.resource.data.holderUid)
        && request.resource.data.holderName == get(/databases/$(database)/documents/users/$(request.resource.data.holderUid)).data.displayName
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt <= request.time
        && request.resource.data.endsAt > request.time
        && request.resource.data.holderName is string
        && request.resource.data.handoverHistory is list
        && request.resource.data.handoverHistory.size() == 0
        && request.resource.data.assignedByUid == request.auth.uid
        && request.resource.data.assignedByName is string
        && request.resource.data.assignedAt == request.time
        && request.resource.data.startedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only active supervisors may assign or replace the emergency holder.
      // Administration has read-only oversight and cannot terminate or change an assignment.
      allow update: if isActiveSupervisor()
        && resource.data.endsAt > request.time
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.startsAt == resource.data.startsAt
        && request.resource.data.endsAt == resource.data.endsAt
        && request.resource.data.shiftLabel == resource.data.shiftLabel
        && validEmergencyHolder(request.resource.data.holderUid)
        && request.resource.data.holderName == get(/databases/$(database)/documents/users/$(request.resource.data.holderUid)).data.displayName
        && request.resource.data.holderUid != resource.data.holderUid
        && request.resource.data.holderName is string
        && request.resource.data.handoverHistory is list
        && (
          resource.data.holderUid == ''
          ? request.resource.data.handoverHistory.size() == resource.data.handoverHistory.size()
          : request.resource.data.handoverHistory.size() == resource.data.handoverHistory.size() + 1
        )
        && request.resource.data.handoverHistory.hasAll(resource.data.handoverHistory)
        && request.resource.data.assignedByUid == request.auth.uid
        && request.resource.data.assignedByName is string
        && request.resource.data.assignedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'holderUid', 'holderName', 'handoverHistory', 'updatedAt',
          'assignedByUid', 'assignedByName', 'assignedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /emergency_duty_notes/{noteId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['noteId', 'shiftId', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasAll(['noteId', 'shiftId', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.noteId == noteId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.createdAt == request.time
        && isCurrentEmergencyHolder(request.resource.data.shiftId);
      // Notes remain visible to active staff for continuity between shifts.
      allow get, list: if isActiveUser();
      allow update, delete: if false;
    }

    match /emergency_arrival_reports/{reportId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['reportId', 'shiftId', 'title', 'body', 'originalBody', 'aiAssisted', 'reviewConfirmedBy', 'reviewConfirmedAt', 'recipientUids', 'createdBy', 'createdByName', 'createdAt', 'priority'])
        && request.resource.data.keys().hasAll(['reportId', 'shiftId', 'title', 'body', 'originalBody', 'aiAssisted', 'reviewConfirmedBy', 'reviewConfirmedAt', 'recipientUids', 'createdBy', 'createdByName', 'createdAt', 'priority'])
        && request.resource.data.reportId == reportId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 3
        && request.resource.data.body is string && request.resource.data.body.size() >= 5
        && request.resource.data.originalBody is string
        && request.resource.data.aiAssisted is bool
        && request.resource.data.reviewConfirmedBy == request.auth.uid
        && request.resource.data.reviewConfirmedAt == request.time
        && request.resource.data.priority == 'urgent'
        && request.resource.data.createdAt == request.time
        && validEmergencyRecipients(request.resource.data)
        && isCurrentEmergencyHolder(request.resource.data.shiftId);
      allow get, list: if isActiveUser()
        && (resource.data.createdBy == request.auth.uid || request.auth.uid in resource.data.recipientUids);
      allow update, delete: if false;

      // Administration may add an immutable review comment to a report.
      // The report author and administration can read the complete comment thread.
      match /comments/{commentId} {
        allow create: if isActiveAdmin()
          && request.resource.data.keys().hasOnly([
            'commentId', 'reportId', 'body', 'authorUid', 'authorName', 'authorRole', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'commentId', 'reportId', 'body', 'authorUid', 'authorName', 'authorRole', 'createdAt'
          ])
          && request.resource.data.commentId == commentId
          && request.resource.data.reportId == reportId
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 2
          && exists(/databases/$(database)/documents/emergency_arrival_reports/$(reportId))
          && request.auth.uid in get(/databases/$(database)/documents/emergency_arrival_reports/$(reportId)).data.recipientUids
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == 'admin'
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time;

        allow get, list: if isActiveUser()
          && (
            isActiveAdmin()
            || get(/databases/$(database)/documents/emergency_arrival_reports/$(reportId)).data.createdBy == request.auth.uid
          );

        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      // Admin notices plus atomic emergency assignment/arrival notices.
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'notificationId', 'recipientUid', 'recipientRole', 'senderUid',
          'senderEmail', 'title', 'body', 'priority', 'read', 'createdAt',
          'kind', 'relatedId', 'replyId', 'senderName', 'tickerGroupId',
          'tickerVisible', 'recipientRoles', 'broadcastToAll'
        ])
        && request.resource.data.keys().hasAll([
          'notificationId', 'recipientUid', 'recipientRole', 'senderUid',
          'senderEmail', 'title', 'body', 'priority', 'read', 'createdAt'
        ])
        && request.resource.data.notificationId == notificationId
        && request.resource.data.recipientUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.status == 'active'
        && request.resource.data.recipientRole in ['supervisor', 'security_officer', 'admin']
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.role == request.resource.data.recipientRole
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && (
          isActiveAdmin()
          || (
            request.resource.data.kind == 'staff_message'
            && request.resource.data.body.size() >= 3
            && request.resource.data.relatedId is string
            && exists(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId))
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.senderUid == request.auth.uid
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.senderRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.recipientUid == request.resource.data.recipientUid
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.recipientRole == request.resource.data.recipientRole
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.title == request.resource.data.title
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.body == request.resource.data.body
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.priority == request.resource.data.priority
          )
          || (
            request.resource.data.kind == 'staff_message_reply'
            && request.resource.data.relatedId is string
            && request.resource.data.replyId is string
            && exists(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId))
            && exists(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)/replies/$(request.resource.data.replyId))
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.senderUid == request.resource.data.recipientUid
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)).data.recipientUid == request.auth.uid
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)/replies/$(request.resource.data.replyId)).data.senderUid == request.auth.uid
            && get(/databases/$(database)/documents/staff_messages/$(request.resource.data.relatedId)/replies/$(request.resource.data.replyId)).data.body == request.resource.data.body
          )
          || (
            isActiveSupervisor()
            && request.resource.data.kind == 'emergency_assignment'
            && request.resource.data.relatedId is string
            && existsAfter(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId))
            && getAfter(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId)).data.holderUid == request.resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId)).data.assignedByUid == request.auth.uid
          )
          || (
            isActiveSupervisor()
            && request.resource.data.kind == 'emergency_assignment_ended'
            && request.resource.data.relatedId is string
            && exists(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId))
            && get(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId)).data.holderUid == request.resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId)).data.holderUid != request.resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/emergency_duty_shifts/$(request.resource.data.relatedId)).data.assignedByUid == request.auth.uid
          )
          || (
            request.resource.data.kind == 'emergency_arrival'
            && request.resource.data.relatedId is string
            && existsAfter(/databases/$(database)/documents/emergency_arrival_reports/$(request.resource.data.relatedId))
            && getAfter(/databases/$(database)/documents/emergency_arrival_reports/$(request.resource.data.relatedId)).data.createdBy == request.auth.uid
            && request.resource.data.recipientUid in getAfter(/databases/$(database)/documents/emergency_arrival_reports/$(request.resource.data.relatedId)).data.recipientUids
            && isCurrentEmergencyHolder(getAfter(/databases/$(database)/documents/emergency_arrival_reports/$(request.resource.data.relatedId)).data.shiftId)
          )
        );

      allow get, list: if isActiveUser()
        && (isActiveAdmin() || resource.data.recipientUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);

      // Admins may edit or hide published admin ticker notices only.
      allow update: if (
        isActiveAdmin()
        && (resource.data.kind == 'ticker_announcement'
          || (resource.data.kind == null && resource.data.senderName == 'الإدارة'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'priority', 'tickerVisible'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && (!request.resource.data.keys().hasAny(['tickerVisible'])
          || request.resource.data.tickerVisible is bool)
      ) || (
        isActiveUser()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.read == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time
      );

      allow delete: if false;
    }


    // Work shifts are independent of the employee profile. One active pointer per officer.
    match /active_work_shifts/{uid} {
      allow get: if isActiveUser()
        && (request.auth.uid == uid || isActiveSupervisor() || isActiveAdmin());
      allow list: if isActiveSupervisor() || isActiveAdmin();

      allow create: if isActiveUser()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'security_officer'
        && request.resource.data.keys().hasOnly(['officerUid', 'shiftId', 'startedAt'])
        && request.resource.data.keys().hasAll(['officerUid', 'shiftId', 'startedAt'])
        && request.resource.data.officerUid == uid
        && request.resource.data.shiftId is string
        && request.resource.data.startedAt == request.time
        && existsAfter(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId))
        && getAfter(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId)).data.officerUid == uid
        && getAfter(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId)).data.status == 'active';

      allow update: if false;

      allow delete: if isActiveUser()
        && request.auth.uid == uid
        && resource.data.officerUid == uid
        && exists(/databases/$(database)/documents/work_shifts/$(resource.data.shiftId))
        && getAfter(/databases/$(database)/documents/work_shifts/$(resource.data.shiftId)).data.status == 'completed';
    }

    match /work_shifts/{shiftId} {
      allow get, list: if isActiveUser()
        && (resource.data.officerUid == request.auth.uid
          || isActiveSupervisor() || isActiveAdmin());

      allow create: if isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
        && request.resource.data.keys().hasOnly([
          'shiftId', 'officerUid', 'officerName', 'status', 'startedAt',
          'endedAt', 'activeLocationId', 'activeLocationName'
        ])
        && request.resource.data.keys().hasAll([
          'shiftId', 'officerUid', 'officerName', 'status', 'startedAt',
          'endedAt', 'activeLocationId', 'activeLocationName'
        ])
        && request.resource.data.shiftId == shiftId
        && request.resource.data.officerUid == request.auth.uid
        && request.resource.data.officerName is string
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.activeLocationId is string
        && request.resource.data.activeLocationName is string
        && existsAfter(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid)).data.shiftId == shiftId;

      allow update: if isActiveUser()
        && resource.data.officerUid == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.officerUid == resource.data.officerUid
        && request.resource.data.shiftId == resource.data.shiftId
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.officerName == resource.data.officerName
        && (
          (
            request.resource.data.status == 'active'
            && request.resource.data.endedAt == null
            && request.time < resource.data.startedAt + duration.value(8, 'h')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activeLocationId', 'activeLocationName'
            ])
            && (
              (
                resource.data.activeLocationId == null
                && request.resource.data.activeLocationId is string
                && existsAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(request.resource.data.activeLocationId))
                && getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(request.resource.data.activeLocationId)).data.locationName == request.resource.data.activeLocationName
              )
              || (
                resource.data.activeLocationId is string
                && request.resource.data.activeLocationId == null
                && request.resource.data.activeLocationName == null
                && existsAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(resource.data.activeLocationId))
                && getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(resource.data.activeLocationId)).data.status == 'completed'
              )
            )
          )
          || (
            request.resource.data.status == 'completed'
            && request.resource.data.endedAt == request.time
            && request.resource.data.activeLocationId == null
            && request.resource.data.activeLocationName == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'endedAt', 'activeLocationId', 'activeLocationName'
            ])
            && !existsAfter(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid))
            && (
              resource.data.activeLocationId == null
              || (
                existsAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(resource.data.activeLocationId))
                && getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)/locations/$(resource.data.activeLocationId)).data.status == 'completed'
              )
            )
          )
        );

      allow delete: if false;

      match /locations/{locationId} {
        allow get, list: if isActiveUser()
          && (get(/databases/$(database)/documents/work_shifts/$(shiftId)).data.officerUid == request.auth.uid
            || isActiveSupervisor() || isActiveAdmin());

        allow create: if isActiveUser()
          && getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)).data.officerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)).data.status == 'active'
          && existsAfter(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid)).data.shiftId == shiftId
          && request.time < getAfter(/databases/$(database)/documents/work_shifts/$(shiftId)).data.startedAt + duration.value(8, 'h')
          && request.resource.data.keys().hasOnly([
            'locationId', 'locationName', 'status', 'startedAt', 'endedAt'
          ])
          && request.resource.data.keys().hasAll([
            'locationId', 'locationName', 'status', 'startedAt', 'endedAt'
          ])
          && request.resource.data.locationId == locationId
          && request.resource.data.locationName is string
          && request.resource.data.status == 'active'
          && request.resource.data.startedAt == request.time
          && request.resource.data.endedAt == null;

        allow update: if isActiveUser()
          && get(/databases/$(database)/documents/work_shifts/$(shiftId)).data.officerUid == request.auth.uid
          && get(/databases/$(database)/documents/work_shifts/$(shiftId)).data.status == 'active'
          && resource.data.status == 'active'
          && request.resource.data.status == 'completed'
          && request.resource.data.locationId == resource.data.locationId
          && request.resource.data.locationName == resource.data.locationName
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.endedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'endedAt']);

        allow delete: if false;
      }
    }

    match /work_shift_notes/{noteId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          'noteId', 'shiftId', 'officerUid', 'officerName', 'locationName', 'body', 'recipientUids', 'createdAt'
        ])
        && request.resource.data.noteId == noteId
        && request.resource.data.officerUid is string
        && request.resource.data.officerName is string
        && request.resource.data.locationName is string
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 2
        && request.resource.data.createdAt == request.time
        && validWorkNoteRecipients(request.resource.data)
        && (
          (
            request.resource.data.keys().hasOnly([
              'noteId', 'shiftId', 'officerUid', 'officerName', 'locationName', 'body', 'recipientUids', 'createdAt',
              'ownerDeleteUntil', 'hiddenFromOfficer'
            ])
            && request.resource.data.hiddenFromOfficer == false
            && request.resource.data.ownerDeleteUntil is timestamp
            && request.resource.data.ownerDeleteUntil > request.time
            && request.resource.data.ownerDeleteUntil <= request.time + duration.value(24, 'h')
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
            && request.resource.data.officerUid == request.auth.uid
            && exists(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId))
            && get(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId)).data.officerUid == request.auth.uid
            && get(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId)).data.status == 'active'
            && request.time < get(/databases/$(database)/documents/work_shifts/$(request.resource.data.shiftId)).data.startedAt + duration.value(8, 'h')
            && exists(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid))
            && get(/databases/$(database)/documents/active_work_shifts/$(request.auth.uid)).data.shiftId == request.resource.data.shiftId
          )
          || (
            request.resource.data.keys().hasOnly([
              'noteId', 'shiftId', 'officerUid', 'officerName', 'locationName', 'body', 'recipientUids', 'createdAt',
              'forwardedFromNoteId', 'forwardedByUid', 'forwardedByName'
            ])
            && request.resource.data.keys().hasAll([
              'forwardedFromNoteId', 'forwardedByUid', 'forwardedByName'
            ])
            && (isActiveAdmin() || isActiveSupervisor())
            && request.resource.data.forwardedFromNoteId is string
            && request.resource.data.forwardedByUid == request.auth.uid
            && request.resource.data.forwardedByName is string
            && exists(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId))
            && request.auth.uid in get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.recipientUids
            && request.resource.data.officerUid == get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.officerUid
            && request.resource.data.officerName == get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.officerName
            && request.resource.data.shiftId == get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.shiftId
            && request.resource.data.locationName == get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.locationName
            && request.resource.data.body == get(/databases/$(database)/documents/work_shift_notes/$(request.resource.data.forwardedFromNoteId)).data.body
          )
        );

      allow get, list: if isActiveUser()
        && (
          (
            resource.data.officerUid == request.auth.uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
            && resource.data.hiddenFromOfficer == false
            && request.time < resource.data.createdAt + duration.value(10, 'h')
          )
          || (
            request.auth.uid in resource.data.recipientUids
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'admin']
          )
        );

      allow update: if isActiveUser()
        && resource.data.officerUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
        && resource.data.hiddenFromOfficer == false
        && resource.data.ownerDeleteUntil is timestamp
        && request.time < resource.data.ownerDeleteUntil
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFromOfficer'])
        && request.resource.data.hiddenFromOfficer == true;

      allow delete: if isActiveUser()
        && request.auth.uid in resource.data.recipientUids
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['supervisor', 'admin'];
    }


    // Unified staff messages: each recipient has an isolated document so
    // recipients can only read their own copy; replies remain under that copy.
    match /staff_messages/{messageId} {
      function isMessageParticipant() {
        return isActiveUser()
          && (resource.data.senderUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);
      }

      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'messageId', 'threadId', 'senderUid', 'senderName', 'senderRole', 'senderLabel',
          'recipientUid', 'recipientName', 'recipientRole', 'recipientLabel', 'locationName', 'title', 'body',
          'priority', 'requestReply', 'replyStatus', 'attachments', 'read',
          'hiddenFor', 'showOnTicker', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'messageId', 'threadId', 'senderUid', 'senderName', 'senderRole', 'senderLabel',
          'recipientUid', 'recipientName', 'recipientRole', 'recipientLabel', 'locationName', 'title', 'body',
          'priority', 'requestReply', 'replyStatus', 'attachments', 'read',
          'hiddenFor', 'createdAt'
        ])
        && request.resource.data.messageId == messageId
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        && request.resource.data.recipientUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientUid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.status == 'active'
        && request.resource.data.recipientRole == get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.role
        && request.resource.data.locationName is string
        && request.resource.data.messageId == request.resource.data.threadId + '_' + request.resource.data.recipientUid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 0
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && request.resource.data.requestReply is bool
        && request.resource.data.replyStatus in ['pending', 'not_required']
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() == 0
        && request.resource.data.read == false
        && request.resource.data.hiddenFor is list
        && (!request.resource.data.keys().hasAny(['showOnTicker'])
          || request.resource.data.showOnTicker is bool)
        && request.resource.data.createdAt == request.time
        && (
          isActiveAdmin()
          || (isActiveSupervisor()
            && request.resource.data.recipientRole == 'security_officer')
          || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'security_officer'
            && request.resource.data.recipientRole in ['supervisor', 'admin'])
        );

      allow get, list: if isMessageParticipant()
        || (isActiveUser() && resource.data.showOnTicker == true);

      // Admins may edit or hide published supervisor ticker broadcasts.
      allow update: if (
        isActiveAdmin()
        && resource.data.showOnTicker == true
        && resource.data.senderRole == 'supervisor'
        && resource.data.recipientRole == 'security_officer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'priority', 'showOnTicker'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.body is string
        && request.resource.data.priority in ['normal', 'important', 'urgent']
        && request.resource.data.showOnTicker is bool
      ) || (isActiveUser() && (
        (
          resource.data.recipientUid == request.auth.uid
          && resource.data.read == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true
          && request.resource.data.readAt == request.time
        )
        || (
          isMessageParticipant()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
          && request.resource.data.hiddenFor.size() == resource.data.hiddenFor.size() + 1
          && request.auth.uid in request.resource.data.hiddenFor
          && !(request.auth.uid in resource.data.hiddenFor)
        )
        || (
          resource.data.recipientUid == request.auth.uid
          && resource.data.requestReply == true
          && resource.data.replyStatus == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyStatus', 'lastReplyAt'])
          && request.resource.data.replyStatus == 'replied'
          && request.resource.data.lastReplyAt == request.time
        )
      ));

      allow delete: if false;

      match /replies/{replyId} {
        function parentMessage() {
          return get(/databases/$(database)/documents/staff_messages/$(messageId)).data;
        }
        allow get, list: if isActiveUser()
          && (parentMessage().senderUid == request.auth.uid
            || parentMessage().recipientUid == request.auth.uid);
        allow create: if isActiveUser()
          && parentMessage().recipientUid == request.auth.uid
          && parentMessage().requestReply == true
          && parentMessage().replyStatus == 'pending'
          && request.resource.data.keys().hasOnly([
            'replyId', 'senderUid', 'senderName', 'senderRole', 'senderLabel', 'body', 'attachments', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'replyId', 'senderUid', 'senderName', 'senderRole', 'senderLabel', 'body', 'attachments', 'createdAt'
          ])
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() == 0
          && request.resource.data.replyId == replyId
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderRole == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Daily duty rosters: all active users can read; only administration can manage and publish.
    match /daily_duty_rosters/{dateKey} {
      allow get, list: if isActiveUser() && (isActiveAdmin() || resource.data.status == 'published');
      allow create, update: if isActiveAdmin()
        && request.resource.data.dateKey == dateKey
        && request.resource.data.status in ['draft', 'approved', 'published']
        && request.resource.data.shifts is map
        && request.resource.data.shifts.keys().hasAll(['A', 'B', 'C']);
      allow delete: if isActiveAdmin();

      match /versions/{versionId} {
        allow get, list: if isActiveAdmin();
        allow create: if isActiveAdmin()
          && request.resource.data.archivedAt == request.time
          && request.resource.data.archivedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}